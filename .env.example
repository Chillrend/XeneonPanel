# Proxy Server Configuration
PORT=3001

# Home Assistant Configuration
# Generate a Long-Lived Access Token in Home Assistant Profile > Long-Lived Access Tokens
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# InfluxDB 2.x Configuration
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=home
INFLUX_BUCKET=home_assistant

# If tokens are left blank, the server automatically enters Simulation/Mock Mode
# with realistic dynamic values for immediate preview.
MOCK_MODE=auto
